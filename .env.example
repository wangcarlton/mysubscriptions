# Server
PORT=4000
NODE_ENV=development
# Public URL of the app (the callback URL must match the Google Cloud console setting)
APP_URL=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Google OAuth client (Google Cloud console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string used to sign the session cookie: openssl rand -hex 32
SESSION_SECRET=

# LLM provider key (used by the insights step)
OPENAI_API_KEY=
# Optional AI settings (defaults shown)
OPENAI_MODEL=gpt-5-mini
# Only used to estimate cost in the UI and logs. Check https://openai.com/api/pricing/
OPENAI_INPUT_USD_PER_MTOK=0.25
OPENAI_OUTPUT_USD_PER_MTOK=2
INSIGHTS_PER_SESSION_PER_HOUR=10
INSIGHTS_PER_DAY=300
